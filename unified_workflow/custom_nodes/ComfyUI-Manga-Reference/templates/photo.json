{
  "1": {
    "inputs": {
      "image": "reference_photo.png"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "① 上传参考照片"
    }
  },
  "2": {
    "inputs": {
      "max_side": 768,
      "image": [
        "1",
        0
      ]
    },
    "class_type": "MangaReferenceResize",
    "_meta": {
      "title": "② 完整保留构图 · 调整尺寸"
    }
  },
  "3": {
    "inputs": {
      "unet_name": "moss_image_sft_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "MOSS SFT INT8"
    }
  },
  "4": {
    "inputs": {
      "lora_name": "moss_image_edit_lora_rank_64_bf16.safetensors",
      "strength_model": 1,
      "model": [
        "3",
        0
      ]
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "图片编辑 LoRA · 必须安装"
    }
  },
  "5": {
    "inputs": {
      "clip_name": "qwen3.5_9b_int8_convrot.safetensors",
      "type": "moss_image",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "MOSS 文本编码器"
    }
  },
  "6": {
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "FLUX.2 VAE"
    }
  },
  "7": {
    "inputs": {
      "prompt": "Convert the reference image into finished black-and-white manga with crisp expressive ink contours, elegant fine crosshatching and clean white paper. Preserve the same face, hairstyle, glasses, clothing, pose, camera viewpoint and background composition. One image only, no panel dividers, no lettering.",
      "edit_format": "Moss-Image-Edit",
      "image_strength": 1,
      "clip": [
        "5",
        0
      ],
      "images.image_0": [
        "2",
        0
      ],
      "vae": [
        "6",
        0
      ]
    },
    "class_type": "TextEncodeMOSSImageEdit",
    "_meta": {
      "title": "③ 漫画化指令 · 保留人物和镜头"
    }
  },
  "8": {
    "inputs": {
      "prompt": "different identity, changed pose, missing glasses, extra fingers, deformed face, lettering, watermark, additional panels",
      "edit_format": "Moss-Image-Edit",
      "image_strength": 1,
      "clip": [
        "5",
        0
      ],
      "images.image_0": [
        "2",
        0
      ],
      "vae": [
        "6",
        0
      ]
    },
    "class_type": "TextEncodeMOSSImageEdit",
    "_meta": {
      "title": "负面指令 · 同样接参考图"
    }
  },
  "9": {
    "inputs": {
      "pixels": [
        "2",
        0
      ],
      "vae": [
        "6",
        0
      ]
    },
    "class_type": "VAEEncode",
    "_meta": {
      "title": "原图潜空间 · 保留构图"
    }
  },
  "10": {
    "inputs": {
      "shift": 5,
      "sampling": "flow",
      "model": [
        "4",
        0
      ]
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {
      "title": "MOSS 采样移位"
    }
  },
  "11": {
    "inputs": {
      "seed": 42,
      "steps": 30,
      "cfg": 3,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.65,
      "model": [
        "10",
        0
      ],
      "positive": [
        "7",
        0
      ],
      "negative": [
        "8",
        0
      ],
      "latent_image": [
        "9",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "④ 重绘强度：越低越接近原图"
    }
  },
  "12": {
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "vae": [
        "6",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "漫画解码"
    }
  },
  "13": {
    "inputs": {
      "filename_prefix": "MOSS_Reference/Photo",
      "images": [
        "12",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "保存漫画"
    }
  }
}